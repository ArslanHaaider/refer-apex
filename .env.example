NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service-role key (Project Settings > API in Supabase). Server-only, never
# expose to the client — bypasses Row Level Security. Required for account
# deletion (deleting an auth.users row) via /api/account/delete.
SUPABASE_SERVICE_ROLE_KEY=

# Google Business Profile OAuth
# Set GOOGLE_MOCK=false to use the real OAuth/API flow instead of mock data.
GOOGLE_MOCK=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# 32-byte AES-256-GCM key, base64-encoded, used to encrypt stored Google
# tokens at rest. Generate with: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Google Sheets data-source OAuth (referral campaigns)
# Set GOOGLE_SHEETS_MOCK=false to use real Sheets service-account sync.
GOOGLE_SHEETS_MOCK=false
# Option A (recommended): set the full JSON key as one line.
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
# Option B: set email + private key separately. Preserve embedded newlines as \n.
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SHEETS_SERVICE_ACCOUNT_PRIVATE_KEY=
# Ask each customer to share their Google Sheet with the service-account email
# above as Viewer. Then store their spreadsheet URL/ID in Data source.

# Days after last_service_date before a contact becomes eligible for referral asks.
REFERRAL_ELIGIBILITY_DAYS=30

# Public app URL used when generating referral links in messages.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Messaging: set MESSAGING_MOCK=false to send via real providers.
MESSAGING_MOCK=true
RESEND_API_KEY=
EMAIL_FROM=Refer Apex <noreply@referapex.app>

# WhatsApp Embedded Signup (Meta) — per-account connection, replaces manual
# access-token entry. Set WHATSAPP_MOCK=false once the Meta App + Embedded
# Signup configuration exist.
WHATSAPP_MOCK=true
NEXT_PUBLIC_META_APP_ID=
META_APP_SECRET=
NEXT_PUBLIC_META_WHATSAPP_CONFIG_ID=
# Self-chosen secret used only to verify Meta's webhook GET handshake.
META_WEBHOOK_VERIFY_TOKEN=

# Protects /api/cron/daily-sync (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
